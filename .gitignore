# Staging copies used to move files to the Windows box that drives the phone.
*.ps1.txt
*.md.txt
*.7z

# Captured data and anything the scripts write at run time.
signals.csv
scene_calib.csv
scene_surfaces.csv
scene_thresholds.json
coverage.csv
joined.csv
tree_w*.txt
layout*.json
inv_*.txt
*.pyc
__pycache__/

# Screenshots and capture sessions. These are pictures of a real phone being
# used, and this repository is PUBLIC. Nothing from a capture run goes in it -
# not the images, not the layout dumps, not the labelled rows that point at
# them. Keep them on the machine that drives the device.
captures/
*.png
*.jpg
*.jpeg
*.webp
*.bmp
uitest.csv
*.calib.csv

# The clustering tool builds its own virtual environment on first run.
.venv/
tools/cluster/.venv/

# Written into a capture directory by cluster.py. Already covered by
# captures/ above, listed so it is explicit: clusters.js embeds the feature
# rows and the screenshot filenames of a real phone session.
clusters.js
labels.json
thumbs/
rows.csv
rows.rebuilt.csv
*.meta

# capture dumps, compressed. captures/ covers them, but a session rebuilt or
# copied elsewhere must not become a public upload of somebody using a phone.
*.json.gz
tools/cluster/feature_reference.html
tools/cluster/reps_payload.json
tools/cluster/shapes.json
tools/cluster/pat_payload.json
tools/cluster/patterns.csv
tools/cluster/surf_payload.json
