# Staging copies used to move files to the Windows box that drives the phone.
*.ps1.txt
*.md.txt
*.7z

# Captured data and anything the scripts write at run time.
signals.csv
scene_calib.csv
scene_surfaces.csv
scene_thresholds.json
coverage.csv
joined.csv
tree_w*.txt
layout*.json
inv_*.txt
*.pyc
__pycache__/

# Screenshots and capture sessions. These are pictures of a real phone being
# used, and this repository is PUBLIC. Nothing from a capture run goes in it -
# not the images, not the layout dumps, not the labelled rows that point at
# them. Keep them on the machine that drives the device.
captures/
*.png
*.jpg
*.jpeg
*.webp
*.bmp
uitest.csv
*.calib.csv

# The clustering tool builds its own virtual environment on first run.
.venv/
tools/cluster/.venv/

# Written into a capture directory by cluster.py. Already covered by
# captures/ above, listed so it is explicit: clusters.js embeds the feature
# rows and the screenshot filenames of a real phone session.
clusters.js
labels.json
thumbs/
rows.csv
rows.rebuilt.csv
*.meta

# capture dumps, compressed. captures/ covers them, but a session rebuilt or
# copied elsewhere must not become a public upload of somebody using a phone.
*.json.gz
tools/cluster/feature_reference.html
tools/cluster/reps_payload.json
tools/cluster/shapes.json
tools/cluster/pat_payload.json
tools/cluster/patterns.csv
tools/cluster/surf_payload.json
tools/cluster/vis_payload.json

# combobul: the engine is installed per machine, not published from here.
# The spec graph's source of truth is combobul/spec/{mutations,snapshots,
# associations} - those stay tracked so a clone can rebuild spec.db with
# `ril rebuild`. The engine, the catalogs and the local cache do not.
# Mirrors know_kernel's rule shape.
combobul/*
!combobul/spec/
combobul/spec/*
!combobul/spec/mutations/
!combobul/spec/snapshots/
!combobul/spec/associations/
.combobul/

node_modules/
# the skills, agents and hooks come from know_kernel and stay per
# machine, like the engine they drive
.claude/

# Generated deliverables. Every one is rebuilt from tracked code plus a
# capture, and a capture never lives here - so these are outputs, not
# sources, and they sit beside the code only because that is where you
# want to open them from. One line per pattern, each naming what builds
# it: INV-GENERATED-HAS-TRACKED-PRODUCER reads these.
#   vectors.html                  <- tools/cluster/vectors_page.py
#   scene_feature_reference.html  <- tools/cluster/vectors_page.py
#   two_payload.json              <- tools/cluster/vectors_build.py
#   patterns.csv                  <- tools/cluster/rs_pattern.py
#   patterns_*.csv                <- tools/cluster/rs_pattern.py
#   scene_data_*.pptx             <- tools/deck/build.cjs
#   scene_data_*.pdf              <- tools/deck/build.cjs
vectors.html
scene_feature_reference.html
two_payload.json
patterns.csv
patterns_*.csv
scene_data_*.pptx
scene_data_*.pdf
